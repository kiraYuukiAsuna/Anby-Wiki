# 生产部署配置（包含机密）。复制到仓库之外再填写，例如 /etc/anby-wiki/.env。
# 文件必须仅允许部署用户读取（chmod 0600），不得提交到仓库。
# 特殊字符值使用单引号；DATABASE_URL 中的密码还需要做 URL 编码。
DEPLOY_ENV=production
RELEASE_ID=replace-with-release-id

# ---- 本地构建元数据 ----
# Anby Wiki 业务镜像只在部署机本地构建，标签为 anby-wiki-<target>:RELEASE_ID。
VCS_REF=local
BUILD_DATE=unknown

# 数据层使用第三方基础镜像；业务镜像不会 push/pull 到任何 registry。
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
ALPINE_IMAGE=alpine:3.22

# ---- 迁移闸门。与镜像发布元数据保持一致。 ----
MIGRATION_EXPECTED_VERSION=1
SCHEMA_MIN_COMPATIBLE_VERSION=1
SCHEMA_MAX_COMPATIBLE_VERSION=1

# ---- 数据层 ----
POSTGRES_DB=wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgres://wiki:replace-with-strong-postgres-password@postgres:5432/wiki?sslmode=disable
S3_REGION=us-east-1
S3_BUCKET=anby-wiki-assets
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-strong-s3-secret-key

# ---- 对外暴露 ----
# web 是唯一发布端口的服务。默认只绑本机，由外层代理决定是否公开。
WEB_BIND=127.0.0.1
WEB_PORT=3000

# ---- 浏览器来源与会话 ----
# 精确 origin，与用户实际访问的地址一致。
TRUSTED_ORIGINS=http://wiki.example.com
# 本清单不终结 TLS。仅当外层确实提供 HTTPS 时才设为 true。
SESSION_COOKIE_SECURE=false

# ---- 认证（早期阶段占位） ----
# 该登录方式不验证真实身份，接入真实身份提供方后应设为 false。
AUTH_DEV_LOGIN_ENABLED=true
AUTH_DEV_LOGIN_TOKEN=replace-with-a-long-random-bootstrap-token

# ---- 限流（应用是唯一限流层） ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=1200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=3
# 仅当 API 的直连对端可信、且它已清洗 X-Forwarded-For 时填写该对端 IP。
# 当前默认留空：按 Web 容器这个直连对端计数，安全但属于部署级共享配额。
TRUSTED_PROXY_IPS=

# ---- 可观测性 ----
LOG_LEVEL=info
OBSERVABILITY_DB_INTERVAL=30s
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACE_SAMPLE_RATE=0.1

# ---- AI 来源导入（可选；只有 Worker 接收这些变量） ----
AI_IMPORT_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
