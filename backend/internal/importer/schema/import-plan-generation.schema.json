{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anby.wiki/schemas/import-plan-generation/v1/plan.schema.json",
  "title": "Anby Wiki ImportPlan Generation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "routes", "prompt_injection_detected"],
  "properties": {
    "profile": { "$ref": "#/$defs/profile" },
    "routes": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/route" }
    },
    "prompt_injection_detected": { "type": "boolean" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "language", "useful"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "summary": { "type": "string", "maxLength": 2000 },
        "language": { "type": "string", "minLength": 1, "maxLength": 32 },
        "useful": { "type": "boolean" },
        "subjects": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/subject" }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "kind", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "kind": {
          "enum": ["person", "organization", "place", "work", "character", "event", "product", "concept", "species", "software", "topic", "other"]
        },
        "summary": { "type": "string", "maxLength": 1000 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "quotation"],
      "properties": {
        "chunk_id": { "type": "string", "format": "uuid" },
        "quotation": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "evidence"],
      "properties": {
        "type": { "enum": ["heading", "paragraph", "bullet_list", "quote"] },
        "text": { "type": "string", "maxLength": 12000 },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "replace_block_id": { "type": "string", "format": "uuid" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "title", "reason", "confidence"],
      "properties": {
        "action": { "enum": ["create", "update", "link", "ignore"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "page_id": { "type": "string", "format": "uuid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "related_to": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blocks": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    }
  }
}
