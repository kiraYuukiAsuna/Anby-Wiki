{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anby.wiki/schemas/collaboration/v1/message.schema.json",
  "title": "Collaboration JSON Message v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "document_id",
        "page_id",
        "latest_sequence",
        "schema_version",
        "crdt_codec"
      ],
      "properties": {
        "type": { "const": "hello" },
        "document_id": { "type": "string", "format": "uuid" },
        "page_id": { "type": "string", "format": "uuid" },
        "base_revision_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "latest_sequence": { "type": "integer", "minimum": 0 },
        "schema_version": { "const": 1 },
        "crdt_codec": { "const": "yjs-v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "latest_sequence"],
      "properties": {
        "type": { "const": "ready" },
        "latest_sequence": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "actor_id", "cursor"],
      "properties": {
        "type": { "const": "presence" },
        "actor_id": { "type": "string", "format": "uuid" },
        "client_id": { "type": "string", "format": "uuid" },
        "actor_username": { "type": "string" },
        "actor_display_name": { "type": "string" },
        "cursor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "version": { "const": 1 },
            "block_id": { "type": "string", "format": "uuid" },
            "selection": { "type": "string" },
            "anchor": { "$ref": "#/$defs/position" },
            "head": { "$ref": "#/$defs/position" }
          },
          "dependentRequired": {
            "version": ["anchor", "head"]
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "up_to_sequence"],
      "properties": {
        "type": { "const": "snapshot_saved" },
        "up_to_sequence": { "type": "integer", "minimum": 0 }
      }
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "offset"],
      "properties": {
        "block_id": { "type": "string", "format": "uuid" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "relative_position": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 344
        }
      }
    }
  }
}
