{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anby.wiki/schemas/import-plan/v1/plan.schema.json",
  "title": "Anby Wiki ImportPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_version_id",
    "profile",
    "routes",
    "quality_score",
    "prompt_injection_detected"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_version_id": { "$ref": "#/$defs/uuid" },
    "profile": { "$ref": "#/$defs/profile" },
    "routes": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/route" }
    },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "prompt_injection_detected": { "type": "boolean" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "language", "useful", "subjects"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "summary": { "type": "string", "maxLength": 2000 },
        "language": { "type": "string", "minLength": 1, "maxLength": 32 },
        "useful": { "type": "boolean" },
        "subjects": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/subject" }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "kind", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "kind": {
          "enum": [
            "person",
            "organization",
            "place",
            "work",
            "character",
            "event",
            "product",
            "concept",
            "species",
            "software",
            "topic",
            "other"
          ]
        },
        "summary": { "type": "string", "maxLength": 1000 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "quotation", "char_start", "char_end"],
      "properties": {
        "chunk_id": { "$ref": "#/$defs/uuid" },
        "quotation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 },
        "page": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "title", "page_id", "reason", "confidence", "related_to", "evidence", "blocks"],
      "properties": {
        "action": { "enum": ["create", "update", "link", "ignore"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "page_id": { "type": ["string", "null"], "format": "uuid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "related_to": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blocks": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "action": { "const": "create" },
            "page_id": { "type": "null" },
            "related_to": { "maxItems": 0 },
            "evidence": { "maxItems": 0 },
            "blocks": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "action": { "const": "update" },
            "page_id": { "$ref": "#/$defs/uuid" },
            "related_to": { "maxItems": 0 },
            "evidence": { "maxItems": 0 },
            "blocks": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "action": { "const": "link" },
            "page_id": { "$ref": "#/$defs/uuid" },
            "related_to": { "minItems": 1 },
            "evidence": { "minItems": 1 },
            "blocks": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "action": { "const": "ignore" },
            "page_id": { "type": "null" },
            "related_to": { "maxItems": 0 },
            "evidence": { "maxItems": 0 },
            "blocks": { "maxItems": 0 }
          }
        }
      ]
    },
    "block_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "target_block_id", "evidence"],
      "properties": {
        "type": { "type": "string" },
        "mode": { "enum": ["append", "replace"] },
        "target_block_id": { "type": ["string", "null"], "format": "uuid" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/heading_block" },
        { "$ref": "#/$defs/paragraph_block" },
        { "$ref": "#/$defs/bullet_list_block" },
        { "$ref": "#/$defs/quote_block" }
      ]
    },
    "heading_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "target_block_id", "text", "level", "evidence"],
      "properties": {
        "type": { "const": "heading" },
        "mode": { "enum": ["append", "replace"] },
        "target_block_id": { "type": ["string", "null"], "format": "uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "append" },
            "target_block_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "mode": { "const": "replace" },
            "target_block_id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "paragraph_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "target_block_id", "text", "evidence"],
      "properties": {
        "type": { "const": "paragraph" },
        "mode": { "enum": ["append", "replace"] },
        "target_block_id": { "type": ["string", "null"], "format": "uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "append" },
            "target_block_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "mode": { "const": "replace" },
            "target_block_id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "bullet_list_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "target_block_id", "items", "evidence"],
      "properties": {
        "type": { "const": "bullet_list" },
        "mode": { "enum": ["append", "replace"] },
        "target_block_id": { "type": ["string", "null"], "format": "uuid" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "append" },
            "target_block_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "mode": { "const": "replace" },
            "target_block_id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "quote_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "target_block_id", "text", "evidence"],
      "properties": {
        "type": { "const": "quote" },
        "mode": { "enum": ["append", "replace"] },
        "target_block_id": { "type": ["string", "null"], "format": "uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "append" },
            "target_block_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "mode": { "const": "replace" },
            "target_block_id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    }
  }
}
