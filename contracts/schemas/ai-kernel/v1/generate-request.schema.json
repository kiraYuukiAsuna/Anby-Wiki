{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anby.wiki/schemas/ai-kernel/v1/generate-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "config", "system_prompt", "user_prompt", "json_schema"],
  "properties": {
    "version": { "const": 1 },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "base_url", "api_key", "model", "response_format", "request_timeout_seconds", "max_attempts"],
      "properties": {
        "provider": { "enum": ["openai-compatible", "deepseek"] },
        "base_url": { "type": "string", "format": "uri", "minLength": 1 },
        "api_key": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "response_format": { "enum": ["json_object", "json_schema"] },
        "request_timeout_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "system_prompt": { "type": "string", "minLength": 1 },
    "user_prompt": { "type": "string", "minLength": 1 },
    "json_schema": { "type": "object" }
  }
}
