{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anby.wiki/schemas/ast/v1/ast.schema.json",
  "title": "Anby Wiki Typed Block AST v1",
  "description": "Wiki 页面正文的权威格式：树形 Typed Block AST。每个可独立移动/引用/修改的 Block 持有稳定 UUIDv7 ID（见 ADR-0008）。v1 只允许 additive 演进。",
  "type": "object",
  "required": ["type", "schema_version", "children"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "document" },
    "schema_version": { "const": 1 },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "blockId": {
      "type": "string",
      "format": "uuid",
      "description": "稳定 Block ID，UUIDv7，标准 36 字符小写连字符形式（ADR-0008）。"
    },
    "block": {
      "description": "Block 判别联合：按 type 字段判别。新增 Block 类型属于 additive 变更，在此追加分支。",
      "oneOf": [
        { "$ref": "#/$defs/headingBlock" },
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/bulletListBlock" },
        { "$ref": "#/$defs/orderedListBlock" },
        { "$ref": "#/$defs/listItemBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/tableRowBlock" },
        { "$ref": "#/$defs/tableCellBlock" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/preformattedBlock" },
        { "$ref": "#/$defs/equationBlock" },
        { "$ref": "#/$defs/todoBlock" },
        { "$ref": "#/$defs/toggleBlock" },
        { "$ref": "#/$defs/breadcrumbBlock" },
        { "$ref": "#/$defs/columnListBlock" },
        { "$ref": "#/$defs/columnBlock" },
        { "$ref": "#/$defs/buttonBlock" },
        { "$ref": "#/$defs/htmlBlock" },
        { "$ref": "#/$defs/quoteBlock" },
        { "$ref": "#/$defs/calloutBlock" },
        { "$ref": "#/$defs/componentBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/videoBlock" },
        { "$ref": "#/$defs/audioBlock" },
        { "$ref": "#/$defs/fileBlock" },
        { "$ref": "#/$defs/pdfBlock" },
        { "$ref": "#/$defs/bookmarkBlock" },
        { "$ref": "#/$defs/linkPreviewBlock" },
        { "$ref": "#/$defs/datasetViewBlock" },
        { "$ref": "#/$defs/embedBlock" },
        { "$ref": "#/$defs/dividerBlock" }
      ]
    },
    "headingBlock": {
      "type": "object",
      "required": ["id", "type", "level", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "is_toggleable": { "type": "boolean" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["children"] },
          "then": {
            "required": ["is_toggleable"],
            "properties": { "is_toggleable": { "const": true } }
          }
        }
      ]
    },
    "paragraphBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "paragraph" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" }
        }
      }
    },
    "bulletListBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "bullet_list" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/listItemBlock" },
          "description": "容器规则：list 的 children 只能是 list_item。"
        }
      }
    },
    "orderedListBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "ordered_list" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/listItemBlock" },
          "description": "容器规则：list 的 children 只能是 list_item。"
        }
      }
    },
    "listItemBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "list_item" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "list_item 可含 paragraph 等正文 Block 或嵌套 list（嵌套 list 仍必须经 list_item 包裹）。"
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "table" },
        "caption": { "type": "string" },
        "has_column_header": { "type": "boolean" },
        "has_row_header": { "type": "boolean" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableRowBlock" },
          "description": "容器规则：table → table_row → table_cell。"
        }
      }
    },
    "tableRowBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "table_row" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCellBlock" }
        }
      }
    },
    "tableCellBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "table_cell" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "codeBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "code" },
        "content": { "type": "string" },
        "language": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "preformattedKind": {
      "enum": ["ascii_diagram", "fixed_table", "protocol_trace", "formula_text", "plain"]
    },
    "preformattedBlock": {
      "description": "非程序代码的固定宽度原文；逐字保留空格、换行和对齐。",
      "type": "object",
      "required": ["id", "type", "kind", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "preformatted" },
        "kind": { "$ref": "#/$defs/preformattedKind" },
        "content": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "equationBlock": {
      "description": "块级数学表达式；expression 保存 LaTeX 源文本。",
      "type": "object",
      "required": ["id", "type", "expression"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "equation" },
        "expression": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" }
      }
    },
    "todoBlock": {
      "type": "object",
      "required": ["id", "type", "checked", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "todo" },
        "checked": { "type": "boolean" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "toggleBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "toggle" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "breadcrumbItem": {
      "type": "object",
      "required": ["display_text"],
      "additionalProperties": false,
      "properties": {
        "target_page_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "breadcrumbBlock": {
      "description": "页面层级导航。已知祖先保存稳定 Page ID；当前页可只保存 display_text。",
      "type": "object",
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "breadcrumb" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/breadcrumbItem" }
        }
      }
    },
    "columnListBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "column_list" },
        "children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/columnBlock" },
          "description": "容器规则：column_list 的 children 只能是 column。"
        }
      }
    },
    "columnBlock": {
      "type": "object",
      "required": ["id", "type", "width_ratio", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "column" },
        "width_ratio": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "buttonAction": {
      "oneOf": [
        { "$ref": "#/$defs/buttonInsertBlocksAction" },
        { "$ref": "#/$defs/buttonUpdateRecordAction" },
        { "$ref": "#/$defs/buttonNotificationAction" },
        { "$ref": "#/$defs/buttonWebhookAction" }
      ]
    },
    "buttonInsertBlocksAction": {
      "type": "object",
      "required": ["type", "target_page_id", "blocks"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "insert_blocks" },
        "target_page_id": { "type": "string", "format": "uuid" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "buttonUpdateRecordAction": {
      "type": "object",
      "required": ["type", "record_id", "values"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "update_dataset_record" },
        "record_id": { "type": "string", "format": "uuid" },
        "entity_id": { "type": ["string", "null"], "format": "uuid" },
        "values": { "type": "object" }
      }
    },
    "buttonNotificationAction": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "notification" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "tone": { "enum": ["default", "success", "info", "warning", "error"] }
      }
    },
    "buttonWebhookAction": {
      "description": "Webhook 由受控服务端出口发送；正文渲染器不直接访问外部网络。",
      "type": "object",
      "required": ["type", "url", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "webhook" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "payload": { "type": "object" }
      }
    },
    "buttonBlock": {
      "type": "object",
      "required": ["id", "type", "label", "actions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "button" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "confirmation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/buttonAction" }
        }
      }
    },
    "htmlBlock": {
      "description": "隔离展示上传 HTML。渲染器必须使用无脚本、无网络、无表单能力的 sandbox iframe。",
      "type": "object",
      "required": ["id", "type", "html", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "html" },
        "html": { "type": "string", "maxLength": 200000 },
        "height": { "type": "integer", "minimum": 120, "maximum": 1200 },
        "caption": { "type": "string", "maxLength": 1000 }
      }
    },
    "quoteBlock": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "quote" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "calloutBlock": {
      "type": "object",
      "required": ["id", "type", "kind", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "callout" },
        "kind": { "enum": ["info", "warning", "danger"] },
        "icon": { "type": "string", "minLength": 1, "maxLength": 64 },
        "color": {
          "enum": ["default", "gray", "brown", "orange", "yellow", "green", "blue", "purple", "pink", "red"]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "componentBlock": {
      "description": "冻结版本的 Component 实例。Entity/Claim 值不复制进 AST，由渲染与依赖投影按稳定 ID 解析。",
      "type": "object",
      "required": ["id", "type", "component_id", "component_version", "entity_id", "display_config"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "component" },
        "component_id": { "type": "string", "format": "uuid" },
        "component_version": { "type": "integer", "minimum": 1 },
        "entity_id": { "type": "string", "format": "uuid" },
        "display_config": {
          "type": "object",
          "description": "由对应 ComponentVersion props_schema_json 校验的展示配置。"
        }
      }
    },
    "imageBlock": {
      "description": "图片引用不可变 AssetRevision；正文只保存稳定版本 ID 与无障碍/展示信息。",
      "type": "object",
      "required": ["id", "type", "asset_revision_id", "alt_text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "image" },
        "asset_revision_id": { "type": "string", "format": "uuid" },
        "alt_text": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" }
      }
    },
    "videoBlock": {
      "description": "视频引用不可变 AssetRevision；poster 同样固定到 AssetRevision。",
      "type": "object",
      "required": ["id", "type", "asset_revision_id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "video" },
        "asset_revision_id": { "type": "string", "format": "uuid" },
        "poster_asset_revision_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "audioBlock": {
      "description": "音频引用不可变 AssetRevision；正文保存可读标题与可选音频展示元数据。",
      "type": "object",
      "required": ["id", "type", "asset_revision_id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "audio" },
        "asset_revision_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "artist": { "type": "string", "maxLength": 500 },
        "album": { "type": "string", "maxLength": 500 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "caption": { "type": "string", "maxLength": 1000 }
      }
    },
    "fileBlock": {
      "description": "正文文件卡片固定到不可变 AssetRevision，并提供同源下载入口。",
      "type": "object",
      "required": ["id", "type", "asset_revision_id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "file" },
        "asset_revision_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 1000 }
      }
    },
    "pdfBlock": {
      "description": "PDF 阅读块固定到不可变 AssetRevision；start_page 与 height 仅控制展示。",
      "type": "object",
      "required": ["id", "type", "asset_revision_id", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "pdf" },
        "asset_revision_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "maxLength": 500 },
        "start_page": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 320, "maximum": 1200 },
        "caption": { "type": "string", "maxLength": 1000 }
      }
    },
    "bookmarkBlock": {
      "description": "独立书签卡片；展示元数据在作者解析时冻结，不在阅读请求中回源。",
      "type": "object",
      "required": ["id", "type", "url", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "bookmark" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 },
        "site_name": { "type": "string", "maxLength": 255 },
        "caption": { "type": "string", "maxLength": 1000 }
      }
    },
    "linkPreviewBlock": {
      "description": "Notion 式第三方链接预览；元数据由受控服务端抓取后冻结进 Revision。",
      "type": "object",
      "required": ["id", "type", "url", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "link_preview" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 },
        "site_name": { "type": "string", "maxLength": 255 }
      }
    },
    "datasetViewBlock": {
      "description": "可查询数据不复制进 AST；页面引用冻结的 DatasetView 定义。",
      "type": "object",
      "required": ["id", "type", "dataset_view_id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "dataset_view" },
        "dataset_view_id": { "type": "string", "format": "uuid" }
      }
    },
    "embedBlock": {
      "description": "外部嵌入保存 http/https URL；provider 命中白名单时以受限 sandbox iframe 交互，否则降级为安全链接。",
      "type": "object",
      "required": ["id", "type", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "embed" },
"url": {
          "type": "string",
          "format": "uri"
        },
        "title": { "type": "string", "maxLength": 500 },
        "provider": { "enum": ["youtube", "vimeo", "figma"] },
        "caption": { "type": "string", "maxLength": 1000 }
      }
    },
    "dividerBlock": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": { "const": "divider" }
      },
      "description": "divider 无内容：不允许 content/children 等任何额外字段。"
    },
    "inlineNode": {
      "description": "行内节点判别联合：按 type 字段判别。EntityReference/ClaimReference/CitationReference 由 M4-T06 以 additive 方式追加。",
      "oneOf": [
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/inlineCodeNode" },
        { "$ref": "#/$defs/pageReferenceNode" },
        { "$ref": "#/$defs/pageAnchorReferenceNode" },
        { "$ref": "#/$defs/externalLinkNode" },
        { "$ref": "#/$defs/entityReferenceNode" },
        { "$ref": "#/$defs/claimReferenceNode" },
        { "$ref": "#/$defs/citationReferenceNode" },
        { "$ref": "#/$defs/mathNode" },
        { "$ref": "#/$defs/mentionNode" },
        { "$ref": "#/$defs/dateMentionNode" },
        { "$ref": "#/$defs/databaseMentionNode" }
      ]
    },
    "mark": {
      "enum": ["bold", "italic", "underline", "strikethrough", "code"]
    },
    "inlineColor": {
      "enum": ["gray", "brown", "red", "orange", "yellow", "green", "blue", "purple", "pink"]
    },
    "textNode": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "marks": {
          "type": "array",
          "items": { "$ref": "#/$defs/mark" },
          "uniqueItems": true
        },
        "text_color": { "$ref": "#/$defs/inlineColor" },
        "background_color": { "$ref": "#/$defs/inlineColor" }
      }
    },
    "inlineCodeNode": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "inline_code" },
        "text": { "type": "string" }
      }
    },
    "pageReferenceNode": {
      "description": "页面引用两种互斥形态（oneOf）：已解析（target_page_id）与未解析（resolution_status=unresolved + target_namespace + normalized_title）。页面改名不修改正文引用（设计 §5.1-5.2）。",
      "oneOf": [
        { "$ref": "#/$defs/resolvedPageReference" },
        { "$ref": "#/$defs/unresolvedPageReference" }
      ]
    },
    "resolvedPageReference": {
      "type": "object",
      "required": ["type", "target_page_id", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "page_reference" },
        "target_page_id": { "type": "string", "format": "uuid" },
        "target_heading_block_id": {
          "type": "string",
          "format": "uuid",
          "description": "可选章节锚点：目标页面的 Heading Block ID（设计 §5.1、§9）。"
        },
        "display_text": { "type": "string" }
      }
    },
    "unresolvedPageReference": {
      "type": "object",
      "required": ["type", "resolution_status", "target_namespace", "normalized_title"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "page_reference" },
        "resolution_status": { "const": "unresolved" },
        "target_namespace": { "type": "string" },
        "normalized_title": { "type": "string" },
        "expected_entity_type": { "type": "string" }
      }
    },
    "pageAnchorReferenceNode": {
      "description": "显式章节引用：Page 与 Heading Block 均使用稳定 ID。",
      "type": "object",
      "required": ["type", "target_page_id", "target_heading_block_id", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "page_anchor_reference" },
        "target_page_id": { "type": "string", "format": "uuid" },
        "target_heading_block_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string" }
      }
    },
    "externalLinkNode": {
      "type": "object",
      "required": ["type", "url", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "external_link" },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "v1 直接保存 URL；external_resource_id 规范化属于 M3，不在 v1。"
        },
        "display_text": { "type": "string" }
      }
    },
    "entityReferenceNode": {
      "description": "实体引用（设计 §5.3）：正文提到某个 Entity，使用稳定 entity_id；Entity 改名不修改正文引用。",
      "type": "object",
      "required": ["type", "entity_id", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "entity_reference" },
        "entity_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string" }
      }
    },
    "claimReferenceNode": {
      "description": "Claim 引用（设计 §5.4）：display_text 为安全兜底文本；动态阅读渲染会沿 superseded/Entity merge 映射解析当前 Claim 值。",
      "type": "object",
      "required": ["type", "claim_id", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "claim_reference" },
        "claim_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string" }
      }
    },
    "citationReferenceNode": {
      "description": "Citation 引用（设计 §5.5）：渲染为上标样式的引用标记；display_text 可选，渲染层 title 取 display_text 或 citation 短 id。",
      "type": "object",
      "required": ["type", "citation_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "citation_reference" },
        "citation_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string" }
      }
    },
    "mathNode": {
      "description": "行内数学表达式；expression 使用 LaTeX 源文本，渲染层不得当作 HTML。",
      "type": "object",
      "required": ["type", "expression"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "math" },
        "expression": { "type": "string" }
      }
    },
    "mentionNode": {
      "description": "对稳定 Actor 的行内提及。",
      "type": "object",
      "required": ["type", "actor_id", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "mention" },
        "actor_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string" }
      }
    },
    "dateMentionNode": {
      "description": "日期或闭区间日期提及；display_text 保留作者选择的展示文本。",
      "type": "object",
      "required": ["type", "date", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "date_mention" },
        "date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "display_text": { "type": "string" }
      }
    },
    "databaseMentionNode": {
      "description": "对稳定 Dataset 的行内提及。",
      "type": "object",
      "required": ["type", "dataset_id", "display_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "database_mention" },
        "dataset_id": { "type": "string", "format": "uuid" },
        "display_text": { "type": "string" }
      }
    }
  }
}
