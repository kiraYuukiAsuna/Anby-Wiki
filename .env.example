# 本地开发环境变量样例（scripts/dev.sh 读取）。
#
#   cp .env.example .env
#
# 本文件只描述「如何连接已有的外部依赖」。开发环境不使用 Docker：
# PostgreSQL / Redis / MinIO(S3) 由你自己以任何方式提供（本机安装、
# 远端实例、同事共享环境都可以），dev.sh 只负责启动 api / worker / web。
#
# 必须保持 shell 兼容的 KEY=VALUE 形式（会被 `.` 引入）。

# ---- 运行环境 ----
ENV=development
LOG_LEVEL=debug
API_PORT=8080

# ---- PostgreSQL（权威数据 + Outbox） ----
DATABASE_URL=postgres://wiki:wiki_dev_password@localhost:5432/wiki?sslmode=disable

# ---- Redis（缓存 / 限流计数，可丢弃，ADR-0003） ----
REDIS_URL=redis://localhost:6379/0

# ---- 对象存储（S3 兼容，例如本机 MinIO，ADR-0004） ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wiki-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev

# ---- Revision 冷热分层（API 透明回源 + Worker 归档） ----
# 开发默认关闭自动归档；仍可用 worker -archive-revisions 做一次演练。
REVISION_ARCHIVE_ENABLED=false
REVISION_ARCHIVE_RETENTION=4320h
REVISION_ARCHIVE_INTERVAL=6h
REVISION_ARCHIVE_BATCH_SIZE=50
REVISION_ARCHIVE_MAX_BYTES=67108864

# ---- 搜索 ----
# 开发可用 PostgreSQL FTS；完整关键词/混合/语义检索使用 Meilisearch。
# 使用 Meilisearch 时先自行启动该外部依赖，再把 SEARCH_BACKEND 改为 meilisearch。
SEARCH_BACKEND=postgres
MEILI_URL=http://localhost:7700
MEILI_API_KEY=
MEILI_INDEX=anby_pages
MEILI_TIMEOUT=15s
MEILI_TASK_TIMEOUT=10m
# 本地 HuggingFace Embedder 不向第三方发送正文，首次启用会下载模型。
SEARCH_SEMANTIC_ENABLED=false
MEILI_EMBEDDER_NAME=page-content
MEILI_EMBEDDER_SOURCE=huggingFace
MEILI_EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 仅 MEILI_EMBEDDER_SOURCE=openAi 时填写。
MEILI_EMBEDDER_API_KEY=

# ---- 认证 ----
# 首个注册账号自动成为管理员；建立管理员后可关闭公开注册。
AUTH_REGISTRATION_ENABLED=true
# X-Actor-ID 开发头：仅本地调试用，production 强制关闭。
AUTH_DEV_HEADER_ENABLED=true
SESSION_COOKIE_NAME=anby_session
# 本地是明文 HTTP，因此 Secure cookie 必须关闭，否则浏览器不会回传。
SESSION_COOKIE_SECURE=false
SESSION_TTL=24h
# 仅当反向代理或外部 rewrite 改写 Host 时填写；多个 Origin 用逗号分隔。
COLLABORATION_ORIGIN_PATTERNS=

# ---- 限流（Redis 固定窗口；应用是唯一限流层） ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=1200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=3
# 仅当 API 前面确有可信代理时才填；留空表示以直连对端 IP 计数。
TRUSTED_PROXY_IPS=

# ---- Web ----
# dev.sh 分别把 API_PORT 和 WEB_PORT 交给 Go API 与 Next.js。
WEB_PORT=3000

# ---- AI 控制面基础设施 ----
# 模型供应商、Base URL、模型与 API Key 改在 /admin/ai 配置。
# 32 字节随机密钥的 base64，例如：openssl rand -base64 32。
AI_CONFIG_MASTER_KEY=
# 开发环境需另行启动 services/ai-kernel；生产由 Compose 提供。
AI_KERNEL_URL=http://localhost:8090
AI_KERNEL_INTERNAL_TOKEN=

# ---- 可观测性 ----
# Worker 暴露 Prometheus 指标；OTLP 默认关闭，需要时指向自己的 collector。
WORKER_METRICS_ADDR=:9091
OBSERVABILITY_DB_INTERVAL=30s
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATE=1
