{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anby.wiki/schemas/document-parsing/v1/region-analysis.schema.json",
  "title": "Anby Wiki Document Region Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text", "summary", "structured_data", "confidence", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 120000 },
    "summary": { "type": "string", "maxLength": 8000 },
    "structured_data": { "type": "object", "additionalProperties": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "maxItems": 50
    }
  }
}
