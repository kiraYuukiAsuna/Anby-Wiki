# 生产部署环境变量样例（scripts/deploy.sh 与 Compose 读取）。
#
#   cp infra/deploy/.env.example /etc/anby-wiki/.env
#
# 文件同时包含普通配置与机密，必须位于仓库外，仅允许部署用户读取
#（chmod 0600），不得提交。
#
# “应用配置”部分与仓库根 .env.example 使用相同命名；生产内部地址等可推导值
# 由 Compose 生成，不要求重复填写。

# ---- 运行环境 ----
ENV=production
LOG_LEVEL=info
API_PORT=8080

# ---- 部署控制（仅生产） ----
RELEASE_ID=replace-with-release-id

# 迁移兼容窗口。
MIGRATION_EXPECTED_VERSION=1
SCHEMA_MIN_COMPATIBLE_VERSION=1
SCHEMA_MAX_COMPATIBLE_VERSION=1

# Web 是唯一发布端口的服务；默认只绑本机，由外层代理决定是否公开。
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Compose 数据容器初始化参数。
POSTGRES_DB=wiki
POSTGRES_USER=wiki
# DATABASE_URL 由 Compose 用这三个值自动生成。三个值只允许字母、数字、
# 点、下划线和连字符；
# 推荐 `openssl rand -hex 32`。
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ---- Redis（缓存 / 限流计数，可丢弃，ADR-0003） ----
REDIS_URL=redis://redis:6379/0

# ---- 对象存储（S3 兼容，ADR-0004） ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=anby-wiki-assets
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-strong-s3-secret-key

# ---- Revision 冷热分层 ----
REVISION_ARCHIVE_ENABLED=true
REVISION_ARCHIVE_RETENTION=4320h
REVISION_ARCHIVE_INTERVAL=6h
REVISION_ARCHIVE_BATCH_SIZE=50
REVISION_ARCHIVE_MAX_BYTES=67108864

# ---- 搜索 ----
SEARCH_BACKEND=meilisearch
MEILI_MASTER_KEY=replace-with-strong-meili-master-key
MEILI_INDEX=anby_pages
MEILI_TIMEOUT=15s
MEILI_TASK_TIMEOUT=10m
SEARCH_SEMANTIC_ENABLED=true
MEILI_EMBEDDER_NAME=page-content
MEILI_EMBEDDER_SOURCE=huggingFace
MEILI_EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 仅 MEILI_EMBEDDER_SOURCE=openAi 时填写。
MEILI_EMBEDDER_API_KEY=

# ---- 认证 ----
# 首次受控部署时开启并创建管理员；完成后立即改为 false。
AUTH_REGISTRATION_ENABLED=true
# production 配置校验会拒绝 true。
AUTH_DEV_HEADER_ENABLED=false
SESSION_COOKIE_NAME=anby_session
# 本清单不终结 TLS；外层实际提供 HTTPS 时必须改为 true。
SESSION_COOKIE_SECURE=false
SESSION_TTL=24h
# Next.js 外部 rewrite 会改写上游 Host；HTTPS 部署填写公开 Origin，多个值用逗号分隔。
COLLABORATION_ORIGIN_PATTERNS=

# ---- 限流（Redis 固定窗口；应用是唯一限流层） ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=1200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=3
# 仅当 API 直连对端可信且已清洗 X-Forwarded-For 时填写。
TRUSTED_PROXY_IPS=

# ---- AI 控制面基础设施 ----
# 模型供应商、Base URL、模型与 API Key 改在管理员中心 /admin/ai 配置。
# 必须为 32 字节随机密钥的 base64，例如：openssl rand -base64 32。
AI_CONFIG_MASTER_KEY=replace-with-base64-encoded-32-byte-key
# API/Worker 与 Semantic Kernel Sidecar 的内网共享令牌。
AI_KERNEL_URL=http://ai-kernel:8090
AI_KERNEL_INTERNAL_TOKEN=replace-with-strong-ai-kernel-token

# ---- 可观测性 ----
WORKER_METRICS_ADDR=:9091
OBSERVABILITY_DB_INTERVAL=30s
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACE_SAMPLE_RATE=0.1
